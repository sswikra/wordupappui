rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Genel Seviye ve Kelime Hiyerarsisi: /levels/{levelId}/words/{wordId}
    match /levels/{levelId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /words/{wordId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 2. Kuratorlu Listeler Hiyerarsisi: /curated_lists/{listId}/words/{wordId}
    match /curated_lists/{listId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /words/{wordId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 3. Kullanici Dokumanlari ve Alt Koleksiyonlari: /users/{userId}/{document=**}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
